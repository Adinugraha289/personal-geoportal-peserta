# =====================================================================
# Salin berkas ini menjadi .env, lalu isi nilainya.
# Jangan pernah commit berkas .env yang sudah terisi.
#
# Berkas ini dibagi tiga bagian:
#
#   BAGIAN 1  Wajib. Tanpa ini portal tidak bisa login.
#   BAGIAN 2  Nilai bawaan. Sudah terisi, biasanya tidak perlu diubah.
#   BAGIAN 3  Data spasial. Diperlukan untuk unggah dan hapus layer katalog 2D.
#
# Cara membuat dua nilai acak, pilih salah satu:
#
#   macOS atau Linux:
#     openssl rand -hex 32
#
#   Windows, PowerShell, atau Command Prompt:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Perintah Node.js di atas bekerja di semua sistem, jadi bisa dipakai
# di mana saja kalau ragu.
# =====================================================================


# =====================================================================
# BAGIAN 1 - WAJIB
# =====================================================================

# Koneksi ke database Supabase. Dipakai Prisma untuk login, sesi, dan katalog.
#
# Supabase menyediakan tiga bentuk connection string. Ketiganya dapat dipakai
# Prisma untuk aplikasi ini, dengan satu syarat pada bentuk kedua:
#
#   Session pooler, port 5432        bekerja apa adanya
#     aws-0-<region>.pooler.supabase.com:5432
#
#   Transaction pooler, port 6543    WAJIB memakai ?pgbouncer=true
#     aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#     Tanpa parameter itu, prepared statement tidak dikelola dengan benar.
#
#   Koneksi langsung                 sering gagal pada project baru
#     db.<ref>.supabase.co:5432
#     Host ini hanya punya alamat IPv6, sehingga muncul
#     "could not translate host name".
#
# Yang disarankan: Session pooler, karena paling sedikit syaratnya.
#
# Catatan tentang DIRECT_URL: aplikasi ini TIDAK memerlukannya. Tabel dibuat
# lewat skrip di folder sql/, bukan lewat prisma migrate, sehingga tidak ada
# migrasi yang membutuhkan koneksi langsung. Skema Prisma juga tidak memuat
# directUrl.
#
# Perhatikan bentuk nama penggunanya: postgres.<ref>, bukan postgres saja.
# <ref> adalah Reference ID project, terlihat pada URL dashboard.
#
# Ambil nilainya dari tombol Connect di dashboard project, lalu pilih
# ORM/Prisma. Ganti [YOUR-PASSWORD] dengan kata sandi database Anda. Kalau
# kata sandinya memuat karakter khusus seperti @ atau #, tulis dalam bentuk
# persen (%40, %23).
#
# Contoh Session pooler:
#   DATABASE_URL="postgresql://postgres.abcdefghijklm:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
#
# Contoh Transaction pooler:
#   DATABASE_URL="postgresql://postgres.abcdefghijklm:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres.abcdefghijklm:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
DATABASE_URL=

# Menandatangani access token pada lib/auth/jwt.js.
# Buat dengan perintah acak di bagian atas berkas ini.
JWT_SECRET=

# Sesi NextAuth, dipakai di src/proxy.js dan route NextAuth.
# Buat dengan perintah acak yang sama, hasilnya harus BERBEDA dari JWT_SECRET.
NEXTAUTH_SECRET=

# Alamat aplikasi, TANPA slash di akhir.
# Saat masih di laptop:  http://localhost:3000/portal
# Setelah di VM:         http://IP_EKSTERNAL_VM/portal
NEXTAUTH_URL=http://localhost:3000/portal

# Alamat email yang ditampilkan ke pengguna saat akunnya belum diaktifkan.
# Isi dengan email Anda sendiri.
ADMIN_CONTACT_EMAIL=


# =====================================================================
# BAGIAN 2 - NILAI BAWAAN
# =====================================================================

# Masa berlaku access token. Jangan dikosongkan, karena token yang dibuat
# tanpa masa berlaku akan ditolak.
JWT_EXPIRES_IN=1h

# Diisi otomatis oleh Cloud Build pada deploy pertama.
#
# Sebelum build pertama, pakai image yang benar-benar ada sebagai nilai
# sementara. Jangan memakai nama karangan, karena compose akan mencoba
# menariknya dan gagal dengan "pull access denied". Nilai kosong juga
# bermasalah: interpolasi berjalan sebelum service dipilih, sehingga
# seluruh perintah docker compose gagal, termasuk yang hanya menyalakan
# geoserver.
NEXTJS_IMAGE=nginx:1.27-alpine

AUTH_API_URL=http://localhost:3000/portal/api

# Origin lengkap aplikasi, TANPA slash di akhir. Nilainya sama dengan
# NEXTAUTH_URL. Dipakai kode katalog 3D versi lama untuk menyusun alamat
# berkas model. Kalau dikosongkan, alamat modelnya menjadi
# "undefined/api/..." dan model 3D gagal dibuka.
BASE_URL=http://localhost:3000/portal

# Sama dengan BASE_URL. Dipakai repository versi 12 September 2026 ke atas.
NEXT_PUBLIC_URL_BASE_PATH=http://localhost:3000/portal

# Kata sandi admin GeoServer. Pakai perintah acak 16 byte supaya hanya berisi
# huruf dan angka. Jangan memakai tanda dolar, karena compose membacanya
# sebagai variabel dan karakter setelahnya bisa hilang tanpa peringatan.
GEOSERVER_ADMIN_PASSWORD=


# =====================================================================
# BAGIAN 3 - DATA SPASIAL
#
# Hanya diperlukan oleh fitur katalog yang membuat tabel spasial di PostGIS
# lalu menerbitkannya sebagai layer di GeoServer. Dipakai dua endpoint:
#
#   src/app/api/katalog-data-2d/create/route.js   unggah GeoJSON
#   src/app/api/katalog-data-2d/delete/route.js   hapus layer
#
# Tanpa bagian ini, login, Kelola Akun, Katalog Data 3D, dan halaman publik
# tetap berjalan. Yang gagal hanya unggah dan hapus layer katalog 2D.
# =====================================================================

# Koneksi langsung ke PostGIS, dipakai pustaka pg, bukan Prisma. Nilainya
# diambil dari halaman Supabase yang sama dengan DATABASE_URL, tetapi dipecah
# menjadi empat bagian. Pakai port 5432, bukan pooler 6543.
#
# Contoh, untuk project di region Singapura:
#   POSTGIS_HOST=aws-0-ap-southeast-1.pooler.supabase.com
#   POSTGIS_USER=postgres.abcdefghijklm
POSTGIS_HOST=
POSTGIS_PORT=5432
POSTGIS_DB=postgres
POSTGIS_USER=
POSTGIS_PASSWORD=

# Schema tempat TABEL SPASIAL dibuat. Bebas, dan harus sama dengan kolom
# "schema" pada datastore GeoServer. Pelatihan ini memakai gis.
#
# Jalankan lebih dahulu di SQL Editor Supabase:
#   CREATE SCHEMA IF NOT EXISTS gis;
#
# PENTING: ini BUKAN schema tempat PostGIS dipasang. PostGIS harus dipasang
# di schema public, karena GeoServer hanya menemukan fungsi postgis_lib_version()
# dari schema public atau dari schema yang diisi pada datastore.
POSTGIS_SCHEMA=gis

# Alamat GeoServer DARI DALAM jaringan container, bukan dari luar VM.
#
#   http://geoserver:8080/geoserver    <- benar. "geoserver" adalah nama service
#                                        di docker-compose.yml, dan Docker
#                                        menerjemahkannya ke container.
#   http://localhost:8080/geoserver    <- salah. localhost di sini menunjuk ke
#                                        container aplikasi sendiri, bukan ke
#                                        container GeoServer, sehingga gagal
#                                        dengan "connection refused".
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_USERNAME=admin

# Harus sama persis dengan GEOSERVER_ADMIN_PASSWORD di Bagian 2, karena
# aplikasi memakai nilai ini untuk login ke REST API GeoServer.
GEOSERVER_PASSWORD=

# Workspace tempat layer katalog diterbitkan.
GEOSERVER_WORKSPACE=geoportal

# Nama datastore PostGIS yang sudah dibuat di GeoServer dan menunjuk ke
# database yang sama dengan POSTGIS_* di atas.
GEOSERVER_POSTGIS_DATASTORE=
